# PathogenIQ environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Dashboard auth ────────────────────────────────────────────────────────────
PATHOGENIQ_DASH_USER=admin
PATHOGENIQ_DASH_PASS=changeme

# ── Slack alerting ────────────────────────────────────────────────────────────
PATHOGENIQ_SLACK_WEBHOOK=

# ── Email alerting ────────────────────────────────────────────────────────────
PATHOGENIQ_SMTP_USER=you@gmail.com
PATHOGENIQ_SMTP_PASS=
PATHOGENIQ_ALERT_EMAILS=lab@example.edu,director@example.edu

# ── Watcher ───────────────────────────────────────────────────────────────────
WATCH_INTERVAL=3600
