# PathogenIQ environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Dashboard auth ────────────────────────────────────────────────────────────
PATHOGENIQ_DASH_USER=admin
PATHOGENIQ_DASH_PASS=changeme

# ── Slack alerting ────────────────────────────────────────────────────────────
PATHOGENIQ_SLACK_WEBHOOK=

# ── Email alerting ────────────────────────────────────────────────────────────
PATHOGENIQ_SMTP_USER=you@gmail.com
PATHOGENIQ_SMTP_PASS=
PATHOGENIQ_ALERT_EMAILS=lab@example.edu,director@example.edu

# ── Watcher ───────────────────────────────────────────────────────────────────
WATCH_INTERVAL=3600

# ── SaaS mode (org-scoped Postgres + JWT auth) ─────────────────────────────────
# Leave PATHOGENIQ_MODE unset (or "selfhosted") for the single-tenant SQLite +
# Basic Auth setup above — that path is untouched and is what the CLI/watcher
# use by default. Set these only when running the hosted, multi-tenant product.
PATHOGENIQ_MODE=selfhosted

# Postgres connection string. For local dev, this matches the `postgres`
# service in docker-compose.yml. In production, use your managed Postgres
# connection string (e.g. Supabase: Project Settings → Database → Connection string).
DATABASE_URL=postgresql+psycopg://pathogeniq:pathogeniq_dev@localhost:5432/pathogeniq_saas

# Shared secret used to verify JWTs on every API request. For local dev this
# can be any random string (mint test tokens signed with the same value). In
# production, use your Supabase project's JWT secret (Project Settings → API
# → JWT Settings → JWT Secret) so tokens issued by Supabase Auth verify here.
PATHOGENIQ_JWT_SECRET=

# Supabase project URL and anon key, used only by the login page (login.html)
# to call Supabase Auth's REST API directly from the browser. Find these at
# Project Settings → API. Leave blank until you've created a Supabase project.
PATHOGENIQ_SUPABASE_URL=
PATHOGENIQ_SUPABASE_ANON_KEY=
