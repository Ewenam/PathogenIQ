# PathogenIQ environment configuration
# Copy to .env and fill in your credentials.
# .env is in .gitignore — never commit credentials.

# ── Alert: Slack ─────────────────────────────────────────────────────────────
# Create an incoming webhook at https://api.slack.com/messaging/webhooks
PATHOGENIQ_SLACK_WEBHOOK=

# ── Alert: Email (SMTP) ───────────────────────────────────────────────────────
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
PATHOGENIQ_SMTP_USER=
PATHOGENIQ_SMTP_PASS=
# Comma-separated list of alert recipient addresses
PATHOGENIQ_ALERT_EMAILS=

# ── Watcher ───────────────────────────────────────────────────────────────────
# How often (seconds) to poll the data directory for new reports
WATCH_INTERVAL=3600
